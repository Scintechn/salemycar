# ----------------------------------------------------------------------------
# Supabase (shared project — our objects live in the `salemycar` schema)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...   # SERVER ONLY, never expose
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...       # safe to ship to client
SUPABASE_SCHEMA=salemycar

# ----------------------------------------------------------------------------
# Pricing (public-safe — tune without redeploying)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_LIST_PRICE=15800
OWNER_NET_TARGET=15000
AFFILIATE_COMMISSION=500
BUYER_DISCOUNT=300

# ----------------------------------------------------------------------------
# Owner contact
# ----------------------------------------------------------------------------
OWNER_WHATSAPP=351XXXXXXXXX            # E.164 without the "+" (for wa.me links)
NEXT_PUBLIC_OWNER_FIRST_NAME=Pedro     # used in copy for personalization

# ----------------------------------------------------------------------------
# Admin (HTTP Basic Auth on /admin)
# ----------------------------------------------------------------------------
ADMIN_USER=owner
ADMIN_PASSWORD=change-me-strong-password

# ----------------------------------------------------------------------------
# WhatsApp via Evolution API (same provider used by Scintechn/flowdeski).
# Connect the owner's WhatsApp number once to the Evolution server via QR,
# then the pilot just calls sendText on that instance.
#
# WHATSAPP_ENABLED=false → messages are logged to console (lead is still saved).
# Set to "true" only when EVOLUTION_API_URL/KEY/INSTANCE_NAME are all set.
# ----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=https://evo.example.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=salemycar

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://salemycar.vercel.app
